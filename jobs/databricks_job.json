{
  "name": "aml_lakehouse_pipeline_daily",
  "comment": "Databricks Jobs API 2.1 definition. Import via Workflows UI (Jobs > Create Job > JSON view / 'Edit as JSON') or `databricks jobs create --json @jobs/databricks_job.json` using the Databricks CLI. Update each notebook_path to where you imported the /notebooks folder in your workspace.",
  "tags": {
    "project": "aml-lakehouse-pipeline",
    "domain": "FCU-Technology-demo"
  },
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "Europe/Warsaw",
    "pause_status": "PAUSED"
  },
  "email_notifications": {
    "on_failure": [
      "your_email@example.com"
    ],
    "no_alert_for_skipped_runs": true
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "bronze_ingestion",
      "description": "Land raw CSV batches + watchlist into Bronze Delta tables",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/your_email@example.com/aml-lakehouse-pipeline/notebooks/01_bronze_ingestion",
        "source": "WORKSPACE"
      },
      "environment_key": "serverless_default",
      "timeout_seconds": 1800,
      "max_retries": 1
    },
    {
      "task_key": "silver_transform",
      "description": "Clean, deduplicate, and MERGE upsert into Silver",
      "depends_on": [
        { "task_key": "bronze_ingestion" }
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/your_email@example.com/aml-lakehouse-pipeline/notebooks/02_silver_transform",
        "source": "WORKSPACE"
      },
      "environment_key": "serverless_default",
      "timeout_seconds": 1800,
      "max_retries": 1
    },
    {
      "task_key": "gold_aggregates",
      "description": "Build reporting aggregates + structuring/sanctions detection",
      "depends_on": [
        { "task_key": "silver_transform" }
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/your_email@example.com/aml-lakehouse-pipeline/notebooks/03_gold_aggregates",
        "source": "WORKSPACE"
      },
      "environment_key": "serverless_default",
      "timeout_seconds": 1800,
      "max_retries": 1
    },
    {
      "task_key": "data_quality_checks",
      "description": "Run DQ gate; fails the job (and triggers the alert) on critical failures",
      "depends_on": [
        { "task_key": "gold_aggregates" }
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/your_email@example.com/aml-lakehouse-pipeline/notebooks/04_data_quality_checks",
        "source": "WORKSPACE"
      },
      "environment_key": "serverless_default",
      "timeout_seconds": 900,
      "max_retries": 0
    }
  ],
  "environments": [
    {
      "environment_key": "serverless_default",
      "spec": {
        "client": "1"
      }
    }
  ]
}
